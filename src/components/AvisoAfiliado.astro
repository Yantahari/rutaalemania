---
// AvisoAfiliado.astro — el aviso de afiliado para las superficies `.astro`.
//
// Hermano del plugin `plugins/rehype-aviso-afiliado.mjs`, que hace lo mismo en
// los `.md`. Los dos beben del MISMO fichero (src/data/afiliados.mjs), que es
// la condición del Director del día 162: **el aviso se genera de una fuente
// única, no de copias sueltas**. Cambiar el texto = tocar aquel fichero.
//
// `clase` existe porque el sitio ya pintaba el aviso con dos estilos distintos
// —`link-aviso` en /links y utilidades sueltas en /recursos— y este acto NO
// cambia el aspecto de nada: sólo de dónde sale el texto.
import { AVISO_AFILIADO, AVISO_CLASE } from '../data/afiliados.mjs';

// `inline` (3-sep-2026, día 179 de ops): la forma vigente es un marcador PEGADO
// a cada enlace, no un párrafo tras el bloque (§ 5a Abs. 4 UWG pide que el fin
// comercial sea reconocible, y eso se predica de cada enlace). Con `inline` se
// pinta un <span>, que es lo mismo que genera el plugin en los `.md`.
interface Props { clase?: string; inline?: boolean }
const { clase = '', inline = false } = Astro.props;
const clases = [AVISO_CLASE, clase].filter(Boolean).join(' ');
---
{inline
  ? <span class={clases} data-aviso-afiliado="generado">{AVISO_AFILIADO}</span>
  : <p class={clases} data-aviso-afiliado="generado">{AVISO_AFILIADO}</p>}
